import json
import os

FILE = "memory.json"

def load():
    if not os.path.exists(FILE):
        return {"tasks": [], "goals": [], "agenda": []}
    with open(FILE, "r") as f:
        return json.load(f)

def save(data):
    with open(FILE, "w") as f:
        json.dump(data, f, indent=2)

def add_task(task):
    data = load()
    data["tasks"].append(task)
    save(data)

def add_goal(goal):
    data = load()
    data["goals"].append(goal)
    save(data)

def add_event(event):
    data = load()
    data["agenda"].append(event)
    save(data)

def get_all():
    return load()